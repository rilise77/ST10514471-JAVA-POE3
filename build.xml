<?xml version="1.0" encoding="UTF-8"?>
<project name="QuickChat-Part-3" default="default" basedir=".">
    <description>Builds, tests, and runs the QuickChat Java application.</description>

    <property name="maven.central" value="https://repo.maven.apache.org/maven2"/>
    <import file="nbproject/build-impl.xml" as="netbeans"/>

    <target name="-pre-init" description="Fetch the pinned build dependencies on first use.">
        <mkdir dir="lib"/>
        <get src="${maven.central}/com/google/code/gson/gson/2.11.0/gson-2.11.0.jar"
             dest="lib/gson-2.11.0.jar" skipexisting="true" maxtime="60"/>
        <get src="${maven.central}/junit/junit/4.13.2/junit-4.13.2.jar"
             dest="lib/junit-4.13.2.jar" skipexisting="true" maxtime="60"/>
        <get src="${maven.central}/org/hamcrest/hamcrest-core/1.3/hamcrest-core-1.3.jar"
             dest="lib/hamcrest-core-1.3.jar" skipexisting="true" maxtime="60"/>
    </target>

    <macrodef name="run-isolated-test">
        <attribute name="target"/>
        <sequential>
            <mkdir dir="${build.dir}/test/workspace"/>
            <antcall target="netbeans.@{target}">
                <param name="work.dir" location="${build.dir}/test/workspace"/>
            </antcall>
        </sequential>
    </macrodef>

    <target name="test" depends="-init-project" description="Run all unit tests.">
        <run-isolated-test target="test"/>
    </target>

    <target name="test-single" depends="-init-project">
        <run-isolated-test target="test-single"/>
    </target>

    <target name="test-single-method" depends="-init-project">
        <run-isolated-test target="test-single-method"/>
    </target>

    <target name="debug-test" depends="-init-project">
        <run-isolated-test target="debug-test"/>
    </target>

    <target name="debug-test-method" depends="-init-project">
        <run-isolated-test target="debug-test-method"/>
    </target>

    <target name="jar" depends="compile" description="Build the runnable JAR and its runtime library.">
        <mkdir dir="${dist.dir}/lib"/>
        <copy file="${file.reference.gson-2.11.0.jar}" todir="${dist.dir}/lib"/>
        <jar destfile="${dist.jar}" basedir="${build.classes.dir}" manifest="${manifest.file}">
            <manifest>
                <attribute name="Main-Class" value="${main.class}"/>
                <attribute name="Class-Path" value="lib/gson-2.11.0.jar"/>
            </manifest>
        </jar>
    </target>
</project>
